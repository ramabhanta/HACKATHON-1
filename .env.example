# ==========================================
# 🌾 AgriConnect AI — Environment Configuration
# ==========================================

# Server & Network Configuration
PORT=5000
NODE_ENV=production

# Security & JWT Authentication
JWT_SECRET=agriconnect_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Database Connection (PostgreSQL or local SQLite fallback)
DATABASE_URL=postgres://agriconnect:agri_secret_password_2026@localhost:5432/agriconnect_db

# Machine Learning & AI Microservices
ML_SERVICE_URL=http://localhost:8000
MODEL_PROVIDER=production

# Weather Service Integration (Open-Meteo or WeatherAPI)
WEATHER_API_KEY=optional_open_meteo_requires_no_key

# Cloud Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_BUCKET=agriconnect-crop-images
STORAGE_ACCESS_KEY=your_s3_access_key
STORAGE_SECRET_KEY=your_s3_secret_key

# Payment Gateway (UPI / Razorpay / Cashfree)
PAYMENT_KEY_ID=rzp_test_agriconnect_2026
PAYMENT_KEY_SECRET=rzp_secret_key
