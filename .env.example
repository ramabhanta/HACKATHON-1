# ==============================================================================
# AgriDex Environment Configuration
# ==============================================================================

# Backend Port & Secrets
PORT=5000
NODE_ENV=development
JWT_SECRET=agridex_secure_jwt_secret_key_2026_india
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Key (REQUIRED for Live Neural Vision & Real Answers)
# ------------------------------------------------------------------------------
# 1. Visit: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key" (100% Free)
# 3. Paste your key below:
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Database Configuration (PostgreSQL Cloud)
# ------------------------------------------------------------------------------
# 1. Sign up / login at https://supabase.com
# 2. Click "New Project" (name: agridex-db)
# 3. Go to "SQL Editor", paste backend/src/database/supabase_schema.sql and click "Run"
# 4. Go to Project Settings -> API:
#    - Copy "Project URL" into SUPABASE_URL
#    - Copy "anon public" into SUPABASE_ANON_KEY
#    - Copy "service_role secret" into SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
